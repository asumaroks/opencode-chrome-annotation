{
  "name": "opencode-chrome-annotation",
  "version": "1.0.4",
  "description": "Annotate pages in Chrome and send context into your local OpenCode setup.",
  "type": "module",
  "main": "./dist/plugin.js",
  "exports": {
    ".": "./dist/plugin.js",
    "./plugin": "./dist/plugin.js"
  },
  "files": [
    "index.js",
    "dist/plugin.js",
    "README.md"
  ],
  "scripts": {
    "build:plugin": "bun build src/plugin.ts --target=node --external @opencode/plugin --external effect --external \"effect/*\" --outfile=dist/plugin.js",
    "build:extension": "node scripts/build-extension.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun run build:plugin && node --test",
    "check:extension": "npm run build:extension && node --check extension/background.js && node --check extension/injected/dom.js && node -e \"JSON.parse(require('fs').readFileSync('extension/manifest.json','utf8'))\"",
    "dev": "bun run build:plugin",
    "dev:setup": "bun run build:plugin",
    "build:zip": "node scripts/build-extension-zip.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "prepublishOnly": "bun run build:plugin",
    "publish": "node -e \"if (process.env.npm_command === 'publish') process.exit(0); require('child_process').execSync('npm publish --access public', { stdio: 'inherit' });\""
  },
  "keywords": [
    "opencode",
    "browser",
    "annotation",
    "chrome",
    "plugin",
    "localhost"
  ],
  "author": "Benjamin Shafii",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asumaroks/opencode-chrome-annotation.git"
  },
  "bugs": {
    "url": "https://github.com/asumaroks/opencode-chrome-annotation/issues"
  },
  "homepage": "https://github.com/asumaroks/opencode-chrome-annotation#readme",
  "peerDependencies": {
    "@opencode/plugin": "^2.1.4",
    "effect": "^4.0.1"
  },
  "devDependencies": {
    "@opencode/plugin": "2.1.4",
    "@resvg/resvg-js": "2.6.2",
    "@types/chrome": "*",
    "bun-types": "*",
    "effect": "4.0.1",
    "fflate": "0.8.3",
    "typescript": "*"
  }
}
